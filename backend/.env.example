# Copy to .env and fill in real values for production

# ── MongoDB ──────────────────────────────────────────────────────────────────
# Use MongoDB Atlas free tier: https://www.mongodb.com/atlas
# Format: mongodb+srv://<user>:<pass>@<cluster>.mongodb.net
MONGO_URL="mongodb://localhost:27017"
DB_NAME="watchit_prod"

# ── Security ──────────────────────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(64))"
JWT_SECRET="CHANGE_ME_TO_A_RANDOM_SECRET"

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins
CORS_ORIGINS="https://your-frontend.onrender.com"

# ── Quote Cache ───────────────────────────────────────────────────────────────
# How long to cache stock quotes in seconds (reduces Yahoo Finance API calls)
QUOTE_CACHE_TTL_SECONDS="30"

# ── Email (Resend) ───────────────────────────────────────────────────────────
# Get your key at https://resend.com
RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxxxxxx"
SENDER_EMAIL="onboarding@resend.dev"

# ── Alerts ────────────────────────────────────────────────────────────────────
# Minimum hours between repeated alerts for the same stock
ALERT_COOLDOWN_HOURS="6"

# ── Weekly Digest ─────────────────────────────────────────────────────────────
DIGEST_TIMEZONE="Asia/Kolkata"
DIGEST_HOUR_LOCAL="8"

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_LEVEL="INFO"
