# Backend URL used by the React app. Must be the public HTTPS URL in production.
# Local:   http://localhost:8000
# Render:  https://watchit-api.onrender.com
REACT_APP_BACKEND_URL=http://localhost:8000

# Webpack dev server health check port
WDS_SOCKET_PORT=443

# Set to true if you're using a Render health check plugin
ENABLE_HEALTH_CHECK=false
